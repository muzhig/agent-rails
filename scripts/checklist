#!/usr/bin/env python3
"""checklist: "apply X to every item in Y" where the list comes from the data.

The agent never writes the list and never writes a receipt.

* ``init`` derives the items from a source (a glob, an issue label or a
  command whose output lines are items) and stores the source and a fixed
  check command next to them.
* ``verify`` is the runner: it runs the stored check for each item and, only
  when the check exits 0, writes a receipt signed with an HMAC key kept
  outside the repo.
* ``status`` re-derives the items from the source, so items added after
  ``init`` show up as open, and accepts only receipts whose signature, check
  and content hash still match. A hand-written receipt is reported as forged.
  If a file changes after its receipt, the receipt goes stale.

The Stop hook calls ``status --all --json`` and refuses to let the session
end while anything is open.
"""

import argparse
import glob as globlib
import hashlib
import hmac
import json
import os
import shlex
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path


def rails_dir():
    """Return the state directory (gitignored)."""
    if os.environ.get("AGENT_RAILS_DIR"):
        return Path(os.environ["AGENT_RAILS_DIR"])
    proc = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    return (Path(proc.stdout.strip()) if proc.returncode == 0 else Path.cwd()) / ".rails"


def key_path():
    """Return the receipt key path; it lives outside the repo on purpose."""
    default = Path.home() / ".config" / "agent-rails" / "receipt.key"
    return Path(os.environ.get("AGENT_RAILS_KEY", default))


def load_key(create=False):
    """Load the HMAC key, creating a 0600 random key when asked."""
    path = key_path()
    if not path.exists():
        if not create:
            return None
        path.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        os.write(fd, os.urandom(32).hex().encode())
        os.close(fd)
    return path.read_bytes().strip()


def item_id(item):
    """Return a short, filename-safe id for an item."""
    return hashlib.sha256(item.encode()).hexdigest()[:16]


def content_sha(source, item):
    """Return the sha256 of a file item's bytes; other items have none."""
    if source["kind"] != "glob":
        return None
    path = Path(item)
    return hashlib.sha256(path.read_bytes()).hexdigest() if path.is_file() else "missing"


def derive_items(source):
    """Compute the item list from the source, never from the agent."""
    kind = source["kind"]
    if kind == "glob":
        found = set()
        for pattern in source["patterns"]:
            found.update(p for p in globlib.glob(pattern, recursive=True) if Path(p).is_file())
        return sorted(found)
    if kind == "issues":
        cmd = [os.environ.get("AGENT_RAILS_GH", "gh"), "api", "--paginate",
               f"repos/{{owner}}/{{repo}}/issues?state=all&per_page=100&labels={source['label']}"]
        proc = subprocess.run(cmd, capture_output=True, text=True, check=True)
        decoder, text, pos, issues = json.JSONDecoder(), proc.stdout.strip(), 0, []
        while pos < len(text):
            value, pos = decoder.raw_decode(text, pos)
            issues.extend(value)
            while pos < len(text) and text[pos].isspace():
                pos += 1
        return sorted((str(i["number"]) for i in issues if "pull_request" not in i), key=int)
    if kind == "cmd":
        proc = subprocess.run(source["cmd"], shell=True, capture_output=True, text=True, check=True)
        return sorted({line.strip() for line in proc.stdout.splitlines() if line.strip()})
    raise ValueError(f"unknown source kind {kind}")


def list_path(name):
    """Return the path of a checklist definition."""
    return rails_dir() / "checklists" / f"{name}.json"


def receipt_dir(name):
    """Return the receipts directory of a checklist."""
    return rails_dir() / "receipts" / name


def load_list(name):
    """Load a checklist definition."""
    return json.loads(list_path(name).read_text())


def signature(key, fields):
    """Return the HMAC of the canonical receipt fields."""
    payload = json.dumps(fields, sort_keys=True, separators=(",", ":")).encode()
    return hmac.new(key, payload, hashlib.sha256).hexdigest()


def receipt_fields(checklist, item, exit_code, at, sha):
    """Return the fields a receipt signs."""
    return {"list": checklist["name"], "created": checklist["created"], "item": item,
            "check": checklist["check"], "exit": exit_code, "at": at, "content_sha": sha}


def cmd_init(args):
    """Derive items from the data and store the list with its check."""
    if args.glob:
        source = {"kind": "glob", "patterns": args.glob}
    elif args.issues_label:
        source = {"kind": "issues", "label": args.issues_label}
    else:
        source = {"kind": "cmd", "cmd": args.from_cmd}
    path = list_path(args.name)
    if path.exists() and not args.force:
        print(f"checklist: {args.name} exists; use --force to replace it", file=sys.stderr)
        return 3
    items = derive_items(source)
    if not items:
        print(f"checklist: the source yields no items: {source}", file=sys.stderr)
        return 3
    load_key(create=True)
    checklist = {"name": args.name, "source": source, "check": args.check, "items": items,
                 "created": datetime.now(timezone.utc).isoformat(timespec="seconds")}
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(checklist, indent=2))
    print(json.dumps({"name": args.name, "items": len(items)}))
    return 0


def cmd_verify(args):
    """Run the stored check per item and write a signed receipt on success."""
    checklist = load_list(args.name)
    key = load_key(create=True)
    items = derive_items(checklist["source"]) if args.all or not args.items else args.items
    known = set(checklist["items"]) | set(derive_items(checklist["source"]))
    out_dir = receipt_dir(args.name)
    out_dir.mkdir(parents=True, exist_ok=True)
    failed = 0
    for item in items:
        if item not in known:
            print(json.dumps({"item": item, "ok": False, "why": "not an item of this list"}))
            failed += 1
            continue
        cmd = checklist["check"].replace("{item}", shlex.quote(item))
        proc = subprocess.run(cmd, shell=True, capture_output=True, text=True, env={**os.environ, "ITEM": item})
        if proc.returncode != 0:
            print(json.dumps({"item": item, "ok": False, "exit": proc.returncode, "stderr": proc.stderr.strip()[-300:]}))
            failed += 1
            continue
        at = datetime.now(timezone.utc).isoformat(timespec="seconds")
        fields = receipt_fields(checklist, item, 0, at, content_sha(checklist["source"], item))
        (out_dir / f"{item_id(item)}.json").write_text(json.dumps({**fields, "sig": signature(key, fields)}, indent=2))
        print(json.dumps({"item": item, "ok": True}))
    return 1 if failed else 0


def check_receipt(checklist, item, key):
    """Return 'ok', 'missing', 'forged' or 'stale' for one item's receipt."""
    path = receipt_dir(checklist["name"]) / f"{item_id(item)}.json"
    if not path.exists():
        return "missing"
    receipt = json.loads(path.read_text())
    fields = {k: receipt.get(k) for k in ("list", "created", "item", "check", "exit", "at", "content_sha")}
    if key is None or not hmac.compare_digest(str(receipt.get("sig", "")), signature(key, fields)):
        return "forged"
    if fields["item"] != item or fields["check"] != checklist["check"] or fields["created"] != checklist["created"] or fields["exit"] != 0:
        return "forged"
    if fields["content_sha"] != content_sha(checklist["source"], item):
        return "stale"
    return "ok"


def status_of(name, key):
    """Return the status report of one checklist."""
    checklist = load_list(name)
    current = derive_items(checklist["source"])
    items = sorted(set(checklist["items"]) | set(current))
    report = {"name": name, "total": len(items), "done": 0, "open": [], "forged": [], "stale": [],
              "added_since_init": sorted(set(current) - set(checklist["items"]))}
    for item in items:
        verdict = check_receipt(checklist, item, key)
        if verdict == "ok":
            report["done"] += 1
            continue
        report["open"].append(item)
        if verdict in ("forged", "stale"):
            report[verdict].append(item)
    return report


def cmd_status(args):
    """Print status; exit 2 while any item is open."""
    key = load_key()
    names = args.names
    if args.all or not names:
        lists_dir = rails_dir() / "checklists"
        names = sorted(p.stem for p in lists_dir.glob("*.json")) if lists_dir.exists() else []
    reports = [status_of(name, key) for name in names]
    if args.json:
        print(json.dumps(reports, indent=2))
    else:
        for r in reports:
            print(f"{r['name']}: {r['done']}/{r['total']} done")
            for item in r["open"]:
                tag = " (forged receipt)" if item in r["forged"] else " (stale receipt)" if item in r["stale"] else ""
                print(f"  open: {item}{tag}")
    return 2 if any(r["open"] for r in reports) else 0


def build_parser():
    """Build the argument parser."""
    parser = argparse.ArgumentParser(prog="checklist", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("init", help="derive the item list from the data")
    p.add_argument("name")
    src = p.add_mutually_exclusive_group(required=True)
    src.add_argument("--glob", action="append", help="file glob (repeatable, ** allowed)")
    src.add_argument("--issues-label", help="every issue with this label")
    src.add_argument("--from-cmd", help="shell command; each output line is an item")
    p.add_argument("--check", required=True, help="shell command that proves one item is done; {item} is replaced")
    p.add_argument("--force", action="store_true")
    p.set_defaults(func=cmd_init)
    p = sub.add_parser("verify", help="run the check and write receipts (the runner)")
    p.add_argument("name")
    p.add_argument("items", nargs="*")
    p.add_argument("--all", action="store_true")
    p.set_defaults(func=cmd_verify)
    p = sub.add_parser("status", help="what is still open; exit 2 if anything is")
    p.add_argument("names", nargs="*")
    p.add_argument("--all", action="store_true")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_status)
    return parser


def main(argv=None):
    """Entry point."""
    args = build_parser().parse_args(argv)
    if not os.environ.get("AGENT_RAILS_DIR"):
        os.chdir(rails_dir().parent)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
